/* A non-main module: only declarations.  It calls a hook (PUTDEC) and the
   runtime (MOVE, *, /), which the main module provides, and TWICE, which
   the main module makes PUBLIC.  FACT is PUBLIC and REENTRANT. */
UTIL: DO;
PUTDEC: PROCEDURE (N) EXTERNAL; DECLARE N ADDRESS; END PUTDEC;
TWICE: PROCEDURE (N) ADDRESS EXTERNAL; DECLARE N ADDRESS; END TWICE;
DECLARE TABLE(4) BYTE INITIAL (1, 2, 3, 4);
DECLARE NAME(*) BYTE DATA ('UTIL');
DECLARE COPY(4) BYTE;
SQUARE: PROCEDURE (N) ADDRESS PUBLIC;
    DECLARE N BYTE;
    RETURN DOUBLE(N) * N;
END SQUARE;
MAX: PROCEDURE (A, B) BYTE PUBLIC;
    DECLARE (A, B) BYTE;
    IF A > B THEN RETURN A;
    RETURN B;
END MAX;
FACT: PROCEDURE (N) ADDRESS PUBLIC REENTRANT;
    DECLARE N BYTE;
    IF N <= 1 THEN RETURN 1;
    RETURN FACT(N - 1) * N;
END FACT;
REPORT: PROCEDURE PUBLIC;
    DECLARE (I, SUM) BYTE;
    CALL MOVE(4, .TABLE, .COPY);
    SUM = 0;
    DO I = 0 TO 3;
        SUM = SUM + COPY(I);
    END;
    CALL PUTDEC(SUM);
    CALL PUTDEC(TWICE(1000) / 7);
    CALL PUTDEC(NAME(0));
END REPORT;
END UTIL;
