/* a non-main module between main.plm and b.plm */
A: DO;
EXIT: PROCEDURE (CODE) EXTERNAL; DECLARE CODE BYTE; END EXIT;
STEP2: PROCEDURE (V) BYTE EXTERNAL; DECLARE V BYTE; END STEP2;
STEP1: PROCEDURE (X, Y, Z) ADDRESS PUBLIC;
    DECLARE (X, Z) BYTE, Y ADDRESS;
    RETURN STEP2(X) * Y + Z;
END STEP1;
QUIT: PROCEDURE (CODE) PUBLIC;
    DECLARE CODE BYTE;
    CALL EXIT(CODE);
END QUIT;
END A;
