/* arrays: subscripts, element types, targets, LENGTH/LAST, algorithms.
   Expected values in comments. */
ARRAYS: DO;
PUTDEC: PROCEDURE (N) EXTERNAL; DECLARE N ADDRESS; END PUTDEC;
PUTCH: PROCEDURE (C) EXTERNAL; DECLARE C BYTE; END PUTCH;
DECLARE B(10) BYTE, W(5) ADDRESS, (I, J, T) BYTE, K ADDRESS;
DECLARE (P, Q)(3) BYTE;
DECLARE SIEVE(100) BYTE;
DECLARE BIG(300) ADDRESS;           /* 600 bytes: data offsets beyond 256 */

IDX: PROCEDURE (N) BYTE;
    DECLARE N BYTE;
    RETURN N + 1;
END IDX;

SUMB: PROCEDURE (N) ADDRESS;        /* reads the global array B */
    DECLARE N BYTE, (S, X) ADDRESS;
    S = 0;
    X = 0;
    DO WHILE X < N;
        S = S + B(X);
        X = X + 1;
    END;
    RETURN S;
END SUMB;

REV: PROCEDURE;                     /* a local array */
    DECLARE L(4) BYTE, X BYTE;
    X = 0;
    DO WHILE X < 4;
        L(X) = 'A' + X;
        X = X + 1;
    END;
    DO WHILE X > 0;
        X = X - 1;
        CALL PUTCH(L(X));
    END;
    CALL PUTCH(10);
END REV;

I = 0;
DO WHILE I < 10;
    B(I) = I * 3;                   /* ADDRESS result stored in a BYTE element */
    I = I + 1;
END;
CALL PUTDEC(B(0));                  /* 0 */
CALL PUTDEC(B(9));                  /* 27 */
I = 4;
CALL PUTDEC(B(I));                  /* 12 */
CALL PUTDEC(B(I + 1) + B(I - 1));   /* 15 + 9 = 24 */

K = 0;
DO WHILE K < 5;                     /* ADDRESS elements, ADDRESS subscript */
    W(K) = K * 1000 + 7;
    K = K + 1;
END;
CALL PUTDEC(W(4));                  /* 4007 */
J = 2;
CALL PUTDEC(W(J));                  /* 2007 */
CALL PUTDEC(W(J) - W(J - 1));       /* 1000 */
CALL PUTDEC(W);                     /* unsubscripted = W(0): 7 */
W = 9999;
CALL PUTDEC(W(0));                  /* 9999 */
CALL PUTDEC(B(9) + 250);            /* BYTE + BYTE wraps: 21 */
CALL PUTDEC(B(9) + 300);            /* 327 */

I = 1;
P(I), Q(2), T, W(1) = 77;           /* subscripted and plain targets */
CALL PUTDEC(P(1));                  /* 77 */
CALL PUTDEC(Q(2));                  /* 77 */
CALL PUTDEC(T);                     /* 77 */
CALL PUTDEC(W(1));                  /* 77 */

B(IDX(5)) = B(IDX(1)) + 100;        /* B(6) = B(2) + 100 */
CALL PUTDEC(B(6));                  /* 106 */

CALL PUTDEC(LENGTH(B));             /* 10 */
CALL PUTDEC(LAST(W));               /* 4 */
CALL PUTDEC(LENGTH(T));             /* a scalar: 1 */

I = 0;                              /* sieve of Eratosthenes below 100 */
DO WHILE I < 100;
    SIEVE(I) = 1;
    I = I + 1;
END;
I = 2;
DO WHILE I < 10;
    IF SIEVE(I) THEN DO;
        J = I * I;
        DO WHILE J < 100;
            SIEVE(J) = 0;
            J = J + I;
        END;
    END;
    I = I + 1;
END;
K = 0;
I = 2;
DO WHILE I < 100;
    IF SIEVE(I) THEN K = K + 1;
    I = I + 1;
END;
CALL PUTDEC(K);                     /* 25 primes */

W(0) = 500; W(1) = 20; W(2) = 65535; W(3) = 0; W(4) = 300;
I = 0;                              /* bubble sort */
DO WHILE I < 4;
    J = 0;
    DO WHILE J < 4 - I;
        IF W(J) > W(J + 1) THEN DO;
            K = W(J);
            W(J) = W(J + 1);
            W(J + 1) = K;
        END;
        J = J + 1;
    END;
    I = I + 1;
END;
I = 0;
DO WHILE I < 5;
    CALL PUTDEC(W(I));              /* 0 20 300 500 65535 */
    I = I + 1;
END;

CALL PUTDEC(SUMB(10));              /* 3*45 - 18 + 106 = 223 */
CALL REV;                           /* DCBA */

BIG(299) = 1234;
K = 299;
CALL PUTDEC(BIG(K));                /* 1234 */
BIG(K - 1) = BIG(299) + 1;
CALL PUTDEC(BIG(298));              /* 1235 */
END ARRAYS;
