/* HALT deep inside nested calls still returns to BASIC with its stack */
HALTS: DO;
PUTCH: PROCEDURE (C) EXTERNAL; DECLARE C BYTE; END PUTCH;
CLS: PROCEDURE EXTERNAL; END CLS;
INNER: PROCEDURE (X) BYTE;
    DECLARE X BYTE;
    CALL PUTCH(X);
    HALT;
END INNER;
OUTER: PROCEDURE (X) ADDRESS;
    DECLARE X ADDRESS;
    RETURN X + INNER('Z') * 2;
END OUTER;
CALL CLS;
CALL PUTCH('A');
CALL PUTCH(OUTER(1));
CALL PUTCH('X');
END HALTS;
