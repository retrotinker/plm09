/* CLS, PUTCH (LF sent as CR), PUTDEC through the Color BASIC ROM */
HELLO: DO;
PUTCH: PROCEDURE (C) EXTERNAL; DECLARE C BYTE; END PUTCH;
PUTDEC: PROCEDURE (N) EXTERNAL; DECLARE N ADDRESS; END PUTDEC;
CLS: PROCEDURE EXTERNAL; END CLS;
DECLARE I BYTE;
CALL CLS;
CALL PUTCH('H');
CALL PUTCH('I');
CALL PUTCH(10);
I = 1;
DO WHILE I <= 5;
    CALL PUTDEC(I * 1000);
    I = I + 1;
END;
CALL PUTDEC(0);
CALL PUTDEC(65535);
END HELLO;
