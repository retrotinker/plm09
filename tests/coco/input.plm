/* GETCH from the keyboard until '.', echoing; then EXIT(7) */
INPUT: DO;
PUTCH: PROCEDURE (C) EXTERNAL; DECLARE C BYTE; END PUTCH;
CLS: PROCEDURE EXTERNAL; END CLS;
GETCH: PROCEDURE BYTE EXTERNAL; END GETCH;
EXIT: PROCEDURE (CODE) EXTERNAL; DECLARE CODE BYTE; END EXIT;
DECLARE C BYTE;
CALL CLS;
C = GETCH;
DO WHILE C <> '.';
    CALL PUTCH(C);
    C = GETCH;
END;
CALL EXIT(7);
END INPUT;
