PROGRAM T
  DECLARE B BYTE
  DECLARE C BYTE
  DECLARE W ADDRESS
  ASSIGN (INDEX OUTPUT 3), B = (CALL INPUT 4)
  CALL (CALL TIME B)
  CALL (CALL MOVE 10 (ADDR B) (ADDR (CALL MEMORY 2)))
  ASSIGN W = STACKPTR
  ASSIGN STACKPTR = W
  ASSIGN C = (+ (+ (CALL DEC (+ B 1)) (CALL SCL B 2)) (CALL SCR W C))
  IF (OR (OR (OR CARRY ZERO) SIGN) PARITY)
  THEN
    ASSIGN B = 0
