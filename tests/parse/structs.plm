/* STRUCTURE declarations and member references */
S: DO;
DECLARE AIRPLANE (20) STRUCTURE (SPEED BYTE, ALTITUDE ADDRESS);
DECLARE (A, B) STRUCTURE (KEY BYTE, INFO (3) ADDRESS), P ADDRESS, I BYTE;
DECLARE ITEM BASED P STRUCTURE (NEXT ADDRESS, VAL BYTE);
AIRPLANE(I).ALTITUDE = A.INFO(I + 1) + B.KEY;
P = .AIRPLANE(3).SPEED;
ITEM.VAL = LENGTH(A.INFO) + SIZE(AIRPLANE);
END S;
