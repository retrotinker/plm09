/* statements, dangling ELSE, multiple assignment, nested procedures */
STMTS: DO;
DECLARE X BYTE;
PUTDEC: PROCEDURE (N) EXTERNAL;
    DECLARE N ADDRESS;
END PUTDEC;
OUTER: PROCEDURE (P, Q) ADDRESS;
    DECLARE P BYTE, Q ADDRESS;
    INNER: PROCEDURE BYTE;
        RETURN P + 1;
    END INNER;
    RETURN Q + INNER;
END OUTER;
NOARGS: PROCEDURE;
    RETURN;
END;
X, Y = 1;
IF X THEN IF Y THEN X = 1; ELSE X = 2;
IF X = 1 THEN DO; X = 3; END; ELSE;
LOOP: DO WHILE X < 10;
    X = X + 1;
END LOOP;
DO;
    DECLARE Z BYTE;
    Z = OUTER(1, X);
END;
CALL NOARGS;
CALL PUTDEC(OUTER(X, 2));
HALT;
END STMTS;
