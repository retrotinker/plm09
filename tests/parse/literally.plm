/* LITERALLY: --ast shows the program after substitution */
LITS: DO;
DECLARE DCL LITERALLY 'DECLARE', TRUE LITERALLY '0FFH';
DCL SIZE LITERALLY '10', SQ LITERALLY 'SIZE * SIZE';
DCL TABLE(SIZE) BYTE, (I, J) BYTE;
DCL BUMP LITERALLY 'J = J + 1';
DO I = 0 TO SIZE - 1;
    TABLE(I) = TRUE;
    BUMP;
END;
J = SQ;
END LITS;
