PROGRAM STMTS
  DECLARE X BYTE
  PROCEDURE PUTDEC (N) EXTERNAL
    DECLARE N ADDRESS
  PROCEDURE OUTER (P, Q) ADDRESS
    DECLARE P BYTE
    DECLARE Q ADDRESS
    PROCEDURE INNER BYTE
      RETURN (+ P 1)
    RETURN (+ Q INNER)
  PROCEDURE NOARGS
    RETURN
  ASSIGN X, Y = 1
  IF X
  THEN
    IF Y
    THEN
      ASSIGN X = 1
    ELSE
      ASSIGN X = 2
  IF (= X 1)
  THEN
    DO
      ASSIGN X = 3
  ELSE
    NULL
  LOOP: DO WHILE (< X 10)
    ASSIGN X = (+ X 1)
  DO
    DECLARE Z BYTE
    ASSIGN Z = (CALL OUTER 1 X)
  CALL NOARGS
  CALL (CALL PUTDEC (CALL OUTER X 2))
  HALT
