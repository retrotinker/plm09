PROGRAM S
  DECLARE AIRPLANE(20) STRUCTURE (SPEED BYTE, ALTITUDE ADDRESS)
  DECLARE A STRUCTURE (KEY BYTE, INFO(3) ADDRESS)
  DECLARE B STRUCTURE (KEY BYTE, INFO(3) ADDRESS)
  DECLARE P ADDRESS
  DECLARE I BYTE
  DECLARE ITEM BASED P STRUCTURE (NEXT ADDRESS, VAL BYTE)
  ASSIGN (MEMBER AIRPLANE I ALTITUDE) = (+ (MEMBER A INFO (+ I 1)) (MEMBER B KEY))
  ASSIGN P = (ADDR (MEMBER AIRPLANE 3 SPEED))
  ASSIGN (MEMBER ITEM VAL) = (+ (CALL LENGTH (MEMBER A INFO)) (CALL SIZE AIRPLANE))
